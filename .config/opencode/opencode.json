{
  "$schema": "https://opencode.ai/config.json",
  "autoshare": false,
  "autoupdate": true,
  "lsp": true,

  // Global Permissions Configuration
  "permission": {
    "skill": { "*": "allow" },
    "edit": "deny",
    "bash": "ask",
    "webfetch": "allow",
    "context7": "allow"
  },

  // LLM Providers Configuration
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "llama3.1": {
          "name": "Llama 3.1"
        }
      }
    }
  },

  // MCP Server Configuration
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": true
    },
    "shadcn": {
      "type": "local",
      "command": [
        "npx",
        "shadcn@latest",
        "mcp"
      ]
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    }
  },

  // Agents and Rules Configuration
  "agent": {
    "build": {
      "mode": "primary",
      "model": "zai-coding-plan/glm-4.7",
      "prompt": "{file:./prompts/build.md}",
      "temperature": 0.5,
      "permission": {
        "write": "allow",
        "edit": "allow",
        "bash": "deny",
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "skill": "allow",
        "context7": "allow"
      }
    },
    "plan": {
      "mode": "primary",
      "model": "google/gemini-2.5-flash",
      "prompt": "{file:./prompts/plan.md}",
      "permission": {
        "write": "deny",
        "edit": "deny",
        "bash": "deny",
        "sequential-thinking": "allow"
      }
    },
    "chat": {
      "description": "General purpose agent for various tasks",
      "mode": "primary",
      "permission": {
        "write": "deny",
        "edit": "deny",
        "bash": "deny",
        "read": "deny",
        "grep": "deny",
        "glob": "deny",
        "context7": "allow"
      }
    },
    "code-reviewer": {
      "description": "Reviews code for best practices and potential issues",
      "mode": "subagent",
      "model": "",
      "prompt": "You are a code reviewer. Focus on security, performance, and maintainability.",
      "permission": {
        "write": "deny",
        "edit": "deny"
      }
    },
    "deep-thinker": {
      "description": "Agent that uses high reasoning effort for complex problems",
      "model": "openai/gpt-5",
      "reasoningEffort": "high",
      "textVerbosity": "low"
    }
  },
  "instructions": [
    "CONTRIBUTING.md",
    "docs/guidelines.md",
    ".cursor/rules/*.md",
    "docs/development-standards.md",
    "test/testing-guidelines.md",
    "packages/*/AGENTS.md"
  ],
}
